{
  "gateway": {
    "token": "${OPENCLAW_GATEWAY_TOKEN}",
    "http": { "port": 8080 },
    "log": {
      "file": "C:\\Users\\rinom\\AppData\\Local\\Temp\\openclaw\\openclaw.log",
      "level": "debug"
    }
  },

  "agent": {
    "model": "openai/deepseek-v4-flash",
    "thinking": "medium",
    "fast": false,
    "tools": { "profile": "coding" }
  },

  "providers": {
    "openai": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "baseURL": "https://api.deepseek.com/v1"
    },
    "qwen": {
      "apiKey": "${DASHSCOPE_API_KEY}",
      "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1"
    }
  },

  "models": {
    "deepseek-v4-flash": {
      "provider": "openai",
      "model": "deepseek-chat"
    },
    "qwen3.7-max": {
      "provider": "qwen",
      "model": "qwen3.7-max"
    },
    "qwen-vl-max": {
      "provider": "qwen",
      "model": "qwen-vl-max"
    }
  },

  "plugins": {
    "browser": true,
    "canvas": true,
    "device-pair": true,
    "file-transfer": true,
    "memory-core": true,
    "phone-control": true,
    "talk-voice": true,
    "image": true
  },

  "image": {
    "provider": "qwen",
    "model": "qwen-vl-max"
  },

  "tools": {
    "profiles": {
      "coding": {
        "exclude": ["agents_list", "gateway", "message", "nodes", "tts"]
      }
    }
  },

  "health": {
    "monitor": {
      "interval": 300,
      "startupGrace": 60,
      "channelConnectGrace": 120
    }
  },

  "modelFallback": {
    "policies": [
      {
        "on": "auth",
        "action": "surface_error",
        "retrySameProvider": false
      }
    ]
  },

  "auth": {
    "cooldownWindow": 300,
    "reauthOnFailure": true
  }
}