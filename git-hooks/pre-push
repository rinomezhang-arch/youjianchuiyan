#!/bin/bash
# ============================================================
# pre-push — 推送前拦截钩子（禁止AI直接push main）
# 适用于：天龙(TL-BOT) / 地龙(DL-BOT) / Trae(TRAE-BOT)
# ============================================================

ECHO_PREFIX="[Git Hook - pre-push]"
COMMITTER_NAME=$(git config user.name || echo "unknown")

# 获取当前分支名
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

# ---- 保护分支列表 ----
PROTECTED_BRANCHES=("main" "master")

for PROTECTED in "${PROTECTED_BRANCHES[@]}"; do
    if [ "$CURRENT_BRANCH" = "$PROTECTED" ]; then
        # 如果是人工，放行
        case "$COMMITTER_NAME" in
            "TL-BOT"|"DL-BOT"|"TRAE-BOT")
                echo ""
                echo "$ECHO_PREFIX =========================================="
                echo "$ECHO_PREFIX ❌ 推送被阻断！"
                echo "$ECHO_PREFIX"
                echo "$ECHO_PREFIX AI工具 ($COMMITTER_NAME) 不允许直接推送 $CURRENT_BRANCH 分支"
                echo "$ECHO_PREFIX 请使用功能分支 (feat-tl-*/feat-dl-*/feat-trae-*) 并通过PR合并"
                echo "$ECHO_PREFIX 详见 CONTRIBUTING.md"
                echo "$ECHO_PREFIX =========================================="
                exit 1
                ;;
            *)
                echo "$ECHO_PREFIX ⚠️ 人工推送 $CURRENT_BRANCH 分支，请确保已经过代码审核"
                ;;
        esac
    fi
done

# ---- AI工具分支名校验 ----
case "$COMMITTER_NAME" in
    "TL-BOT")
        if ! echo "$CURRENT_BRANCH" | grep -q '^feat-tl-'; then
            echo "$ECHO_PREFIX ❌ 阻断: 天龙(TL-BOT) 只能推送 feat-tl-* 分支"
            echo "$ECHO_PREFIX 当前分支: $CURRENT_BRANCH"
            exit 1
        fi
        ;;
    "DL-BOT")
        if ! echo "$CURRENT_BRANCH" | grep -q '^feat-dl-'; then
            echo "$ECHO_PREFIX ❌ 阻断: 地龙(DL-BOT) 只能推送 feat-dl-* 分支"
            echo "$ECHO_PREFIX 当前分支: $CURRENT_BRANCH"
            exit 1
        fi
        ;;
    "TRAE-BOT")
        if ! echo "$CURRENT_BRANCH" | grep -q '^feat-trae-'; then
            echo "$ECHO_PREFIX ❌ 阻断: Trae(TRAE-BOT) 只能推送 feat-trae-* 分支"
            echo "$ECHO_PREFIX 当前分支: $CURRENT_BRANCH"
            exit 1
        fi
        ;;
esac

echo "$ECHO_PREFIX ✅ 推送检查通过: $COMMITTER_NAME -> $CURRENT_BRANCH"
exit 0
