#!/bin/bash
# ============================================================
# prepare-commit-msg — 提交文案强制模板钩子
# 适用于：天龙(TL-BOT) / 地龙(DL-BOT) / Trae(TRAE-BOT)
# ============================================================

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# 只在普通提交时检查（不检查 merge、squash、amend 等）
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "commit" ] && [ -n "$3" ]; then
    exit 0
fi

COMMITTER_NAME=$(git config user.name || echo "unknown")
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

ECHO_PREFIX="[Git Hook - prepare-commit-msg]"
VIOLATION=0

# ---- 根据提交者确定要求的前缀 ----
case "$COMMITTER_NAME" in
    "TL-BOT")
        REQUIRED_PREFIX="【天龙】"
        BOT_NAME="天龙"
        ;;
    "DL-BOT")
        REQUIRED_PREFIX="【地龙】"
        BOT_NAME="地龙"
        ;;
    "TRAE-BOT")
        REQUIRED_PREFIX="【Trae】"
        BOT_NAME="Trae"
        ;;
    *)
        # 人工提交，跳过检查
        echo "$ECHO_PREFIX 人工提交 ($COMMITTER_NAME)，跳过模板检查。"
        exit 0
        ;;
esac

# ---- 检查提交信息是否包含要求前缀 ----
if ! echo "$COMMIT_MSG" | grep -q "^$REQUIRED_PREFIX"; then
    echo ""
    echo "$ECHO_PREFIX =========================================="
    echo "$ECHO_PREFIX ❌ 提交文案不符合规范！"
    echo "$ECHO_PREFIX"
    echo "$ECHO_PREFIX 当前提交者: $COMMITTER_NAME → 必须使用 $REQUIRED_PREFIX 前缀"
    echo "$ECHO_PREFIX"
    echo "$ECHO_PREFIX 正确格式："
    echo "$ECHO_PREFIX   【$BOT_NAME】模块-操作：简要改动内容"
    echo "$ECHO_PREFIX"
    echo "$ECHO_PREFIX 示例："
    echo "$ECHO_PREFIX   【$BOT_NAME】业务文档-补充检测清单"
    echo "$ECHO_PREFIX =========================================="
    echo ""
    VIOLATION=1
fi

# ---- 检测空提交信息 ----
if [ -z "$(echo "$COMMIT_MSG" | tr -d '[:space:]')" ]; then
    echo "$ECHO_PREFIX ❌ 阻断: 提交信息为空"
    VIOLATION=1
fi

# ---- 检测过短的提交信息 ----
if [ "${#COMMIT_MSG}" -lt 5 ]; then
    echo "$ECHO_PREFIX ❌ 阻断: 提交信息过短（少于5个字符）"
    VIOLATION=1
fi

if [ "$VIOLATION" -eq 1 ]; then
    exit 1
else
    echo "$ECHO_PREFIX ✅ 提交文案检查通过: $COMMIT_MSG"
    exit 0
fi
