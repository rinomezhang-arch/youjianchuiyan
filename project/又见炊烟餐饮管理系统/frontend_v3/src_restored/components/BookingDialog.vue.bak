<template>
  <el-dialog v-model="visible" title="📋 预订详情" width="720px" class="booking-dialog" :close-on-click-modal="false" @opened="onOpened">
    <el-tabs v-model="activeTab" class="compact-tabs">
      <el-tab-pane label="基本信息" name="basic">
        <el-form ref="formRef" :model="form" label-width="90px" class="booking-form">
          <el-row :gutter="20">
            <el-col :span="12">
              <el-form-item label="📅 日期" prop="booking_date"><el-date-picker v-model="form.booking_date" type="date" placeholder="选择日期" style="width:100%" :disabled-date="disabledPast" /></el-form-item>
            </el-col>
            <el-col :span="12">
              <el-form-item label="⏰ 时段" prop="booking_time">
                <el-select v-model="form.booking_time" placeholder="选择时段" style="width:100%">
                  <el-option v-for="t in timeOptions" :key="t.value" :label="t.label" :value="t.value" />
                </el-select>
              </el-form-item>
            </el-col>
          </el-row>
          <el-row :gutter="20">
            <el-col :span="12">
              <el-form-item label="👤 客户" prop="customer_name">
                <el-autocomplete v-model="form.customer_name" :fetch-suggestions="queryCustomers" placeholder="姓名或手机号" style="width:100%" @select="onCustomerSelect" />
              </el-form-item>
            </el-col>
            <el-col :span="12">
              <el-form-item label="📱 电话" prop="customer_phone"><el-input v-model="form.customer_phone" placeholder="手机号" /></el-form-item>
            </el-col>
          </el-row>
          <el-row :gutter="20">
            <el-col :span="12">
              <el-form-item label="🎉 类型" prop="occasion_type">
                <el-select v-model="form.occasion_type" placeholder="宴席类型" style="width:100%">
                  <el-option v-for="o in occasionOptions" :key="o.value" :label="o.label" :value="o.value" />
                </el-select>
              </el-form-item>
            </el-col>
            <el-col :span="12">
              <el-form-item label="👥 人/桌" prop="guest_per_table"><el-input-number v-model="form.guest_per_table" :min="1" :max="20" style="width:100%" /></el-form-item>
            </el-col>
          </el-row>
          <el-row :gutter="20">
            <el-col :span="8">
              <el-form-item label="🔢 桌数" prop="table_count"><el-input-number v-model="form.table_count" :min="1" :max="200" style="width:100%" /></el-form-item>
            </el-col>
            <el-col :span="8">
              <el-form-item label="🔄 备桌" prop="spare_tables"><el-input-number v-model="form.spare_tables" :min="0" :max="50" style="width:100%" /></el-form-item>
            </el-col>
            <el-col :span="8">
              <el-form-item label="👥 总人数"><el-input :model-value="totalGuests" disabled /></el-form-item>
            </el-col>
          </el-row>
          <el-row :gutter="20">
            <el-col :span="12">
              <el-form-item label="💰 定金" prop="deposit"><el-input v-model="form.deposit" placeholder="0" type="number" /></el-form-item>
            </el-col>
            <el-col :span="12">
              <el-form-item label="📌 状态" prop="booking_status">
                <el-select v-model="form.booking_status" style="width:100%">
                  <el-option v-for="s in statusOptions" :key="s.value" :label="s.label" :value="s.value" />
                </el-select>
              </el-form-item>
            </el-col>
          </el-row>
          <el-form-item label="🪑 桌台">
            <span v-for="t in selectedTables" :key="t.table_id" class="table-tag">{{ t.table_number }}<i class="close-icon" @click="removeTable(t)">×</i></span>
            <el-tag :type="hasDishes ? 'success' : 'info'" size="large" class="menu-status-tag">{{ hasDishes ? '✅ 已点菜' : '📋 未点菜' }}</el-tag>
            <el-button size="small" type="warning" @click="openDishDialog">🍽️ 点菜</el-button>
          </el-form-item>
          <el-form-item label="📝 备注"><el-input v-model="form.remark" type="textarea" :rows="2" placeholder="自动生成备注信息" /></el-form-item>
        </el-form>
      </el-tab-pane>

      <el-tab-pane label="📜 客户历史" name="history">
        <div v-if="customerHistory.length > 0" class="history-list">
          <div v-for="h in customerHistory" :key="h.booking_id" class="history-item">
            <div class="history-header"><span>{{ h.booking_date }}</span><span :class="['history-status', h.booking_status]">{{ statusLabel(h.booking_status) }}</span></div>
            <div class="history-body"><span>{{ h.banquet_name || '宴席' }}</span><span>{{ h.guest_count }}人</span><span>¥{{ h.total_amount }}</span></div>
          </div>
        </div>
        <el-empty v-else description="暂无历史记录" />
      </el-tab-pane>

      <el-tab-pane label="🍽️ 菜单" name="menu">
        <div v-if="dishOrderItems.length > 0" class="dish-list">
          <div v-for="d in dishOrderItems" :key="d.dishId" class="dish-item">
            <span>{{ d.dishName }}</span><span>×{{ d.qty }}</span><span>¥{{ d.price * d.qty }}</span>
          </div>
          <div class="dish-total">合计：¥{{ dishTotal }}</div>
        </div>
        <el-empty v-else description="未点菜" />
      </el-tab-pane>

      <el-tab-pane v-for="biz in bizTabs" :key="biz.key" :label="biz.icon + ' ' + biz.name" :name="biz.key">
        <BizPageWrapper :title="biz.icon + ' ' + biz.name" :subtitle="biz.subtitle" :icon="biz.icon" :has-content="false" :empty-title="'暂无' + biz.name + '任务'" :empty-desc="'宴会确定后自动生成' + biz.name + '任务'" />
      </el-tab-pane>
    </el-tabs>

    <!-- 按钮区 -->
    <div class="dialog-footer">
      <button class="el-button" type="button" id="btn-cancel" style="margin-right:10px">取消</button>
      <button class="el-button el-button--primary" type="button" id="btn-save">保存</button>
    </div>

    <!-- 点菜弹窗 -->
    <DishOrderDialog v-if="dishVisible" v-model="dishVisible" :date="form.booking_date" :period="form.booking_time" :table-name="currentTableName" @confirmed="onDishConfirmed" />
  </el-dialog>
</template>

<script setup>
import { ref, watch, computed } from 'vue'
import { ElMessage } from 'element-plus'
import BizPageWrapper from './BizPageWrapper.vue'
import DishOrderDialog from './DishOrderDialog.vue'
import { searchCustomers } from '../api/customer'
import { onMounted, nextTick } from 'vue'

const props = defineProps({
  modelValue: Boolean,
  date: String,
  tableId: Number,
  tableNumber: String,
  tableName: String
})
const emit = defineEmits(['update:modelValue', 'saved'])

// ========== 常量 ==========
const timeOptions = [
  { label: '☀️ 午餐 11:00', value: '11:00:00' }, { label: '☀️ 午餐 11:30', value: '11:30:00' }, { label: '☀️ 午餐 12:00', value: '12:00:00' },
  { label: '🌙 晚餐 17:00', value: '17:00:00' }, { label: '🌙 晚餐 17:30', value: '17:30:00' }, { label: '🌙 晚餐 18:00', value: '18:00:00' },
  { label: '🌙 晚餐 18:30', value: '18:30:00' }, { label: '🌙 晚餐 19:00', value: '19:00:00' }
]
const occasionOptions = [
  { label: '🍜 零点', value: 'a_la_carte' }, { label: '💒 婚宴', value: 'wedding' }, { label: '🎂 生日宴', value: 'birthday' },
  { label: '💍 订婚宴', value: 'engagement' }, { label: '👶 满月宴', value: 'baby_born' }, { label: '🎓 谢师宴', value: 'graduation' },
  { label: '🤝 帮忙酒', value: 'help_wine' }, { label: '🏠 乔迁宴', value: 'house_move' }, { label: '📈 升迁宴', value: 'promotion' },
  { label: '🏮 团圆宴', value: 'reunion' }, { label: '🙏 答谢宴', value: 'thanksgiving' }, { label: '🍽️ 尾牙宴', value: 'year_end' }
]
const statusOptions = [
  { label: '⏳ 待确认', value: 'pending' }, { label: '✅ 已确认', value: 'confirmed' },
  { label: '🎊 已完成', value: 'completed' }, { label: '❌ 已取消', value: 'cancelled' }
]
const bizTabs = [
  { key: 'floor', icon: '🏗️', name: '楼面', subtitle: '宴会布置与执行' },
  { key: 'kitchen', icon: '👨‍🍳', name: '厨房', subtitle: '菜品制作与出菜' },
  { key: 'front', icon: '🛎️', name: '前台', subtitle: '收银与结账' },
  { key: 'engineering', icon: '🔧', name: '工程', subtitle: '设备与搭建' },
  { key: 'design', icon: '🎨', name: '美工', subtitle: '布置与装饰' },
  { key: 'purchase', icon: '🛒', name: '采购', subtitle: '原料采购' }
]

// ========== 状态 ==========
const visible = ref(props.modelValue)
const activeTab = ref('basic')
const loading = ref(false)
const formRef = ref(null)
const customerHistory = ref([])
const dishVisible = ref(false)
const currentTableName = ref('')

const form = ref(emptyForm())

function emptyForm() {
  return {
    booking_date: '', booking_time: '', customer_name: '', customer_phone: '',
    occasion_type: 'banquet', guest_per_table: 10, table_count: 1, spare_tables: 0,
    deposit: '', booking_status: 'confirmed', remark: ''
  }
}

// 选中的桌台列表
const selectedTables = ref([])

// dish orders from localStorage
const dishOrderItems = ref([])

// ========== 计算 ==========
const totalGuests = computed(() => {
  return (form.value.table_count + form.value.spare_tables) * form.value.guest_per_table
})
const hasDishes = computed(() => dishOrderItems.value.length > 0)
const dishTotal = computed(() => dishOrderItems.value.reduce((sum, d) => sum + d.price * d.qty, 0))

// ========== 标记 ==========
function disabledPast(date) {
  const d = new Date(date)
  d.setHours(0, 0, 0, 0)
  return d.getTime() < Date.now() - 864e5
}

function onCustomerSelect(item) {
  form.value.customer_name = item.value
  form.value.customer_phone = item.phone || ''
  loadCustomerHistory(item.id)
}

async function queryCustomers(qs, cb) {
  if (!qs || qs.length < 1) return cb([])
  try {
    const res = await searchCustomers({ q: qs })
    const data = res.data?.list || res.data?.rows || res.data || []
    const rows = Array.isArray(data) ? data : []
    cb(rows.map(c => ({
      value: c.customer_name || c.name,
      phone: c.customer_phone || c.phone,
      id: c.customer_id || c.id
    })))
  } catch { cb([]) }
}

async function loadCustomerHistory(customerId) {
  try {
    const token = localStorage.getItem('token') || ''
    const res = await fetch('/api/bookings?customer_id=' + encodeURIComponent(customerId), {
      headers: { Authorization: '***' + token }
    })
    const data = await res.json()
    customerHistory.value = data.data?.rows || data.data || []
  } catch { customerHistory.value = [] }
}

function statusLabel(s) {
  const m = { pending: '⏳ 待确认', confirmed: '✅ 已确认', completed: '🎊 已完成', cancelled: '❌ 已取消' }
  return m[s] || s
}

function removeTable(t) {
  selectedTables.value = selectedTables.value.filter(x => x.table_id !== t.table_id)
}

function loadDishOrders() {
  const key = 'dishOrders:' + (form.value.booking_date || '')
  try {
    const raw = localStorage.getItem(key)
    dishOrderItems.value = raw ? JSON.parse(raw) : []
  } catch { dishOrderItems.value = [] }
}

function openDishDialog() {
  currentTableName.value = selectedTables.value.map(t => t.table_number).join('、')
  dishVisible.value = true
}

function onDishConfirmed() {
  dishVisible.value = false
  loadDishOrders()
}

function autoRemark() {
  const tables = form.value.table_count
  const spare = form.value.spare_tables
  const total = totalGuests.value
  form.value.remark = tables + '桌备' + spare + '桌，共' + total + '人'
}

// ========== 生命周期 & 双向绑定 ==========
watch(() => props.modelValue, (val) => {
  visible.value = val
  if (val) {
    form.value = emptyForm()
    if (props.date) form.value.booking_date = props.date
    if (props.tableNumber) selectedTables.value = [{ table_id: props.tableId, table_number: props.tableNumber }]
    activeTab.value = 'basic'
    customerHistory.value = []
    loadDishOrders()
  }
})
watch(visible, (v) => emit('update:modelValue', v))
watch(() => [form.value.table_count, form.value.spare_tables, form.value.guest_per_table], autoRemark)

function onOpened() {
  // 弹窗打开后，自动填一些默认值
  if (!form.value.booking_time) form.value.booking_time = '18:00:00'
  // 原生 onclick 绑定（Vue @click 在 build 时可能丢失）
  const bindBtns = () => {
    const saveBtn = document.getElementById('btn-save')
    const cancelBtn = document.getElementById('btn-cancel')
    if (saveBtn) {
      saveBtn.onclick = doSave
      saveBtn.style.background = '#b45309'  // 临时，确认绑定成功
    }
    if (cancelBtn) cancelBtn.onclick = doCancel
  }
  // 多轮尝试确保绑定
  bindBtns()
  setTimeout(bindBtns, 200)
  setTimeout(bindBtns, 500)
  setTimeout(bindBtns, 1000)
}

// ========== 保存/取消（核心） ==========
async function doSave() {
  console.log('doSave called', form.value)
  ElMessage.info('保存中...')
  
  // 手动校验必填
  if (!form.value.booking_date) { ElMessage.warning('请选择日期'); return }
  if (!form.value.booking_time) { ElMessage.warning('请选择时段'); return }
  if (!form.value.customer_name || !form.value.customer_name.trim()) { ElMessage.warning('请填写客户姓名'); return }
  if (!form.value.customer_phone || !form.value.customer_phone.trim()) { ElMessage.warning('请填写联系电话'); return }

  loading.value = true
  const token = localStorage.getItem('token') || ''
  const body = {
    booking_date: form.value.booking_date,
    booking_time: form.value.booking_time,
    customer_name: form.value.customer_name.trim(),
    customer_phone: form.value.customer_phone.trim(),
    occasion_type: form.value.occasion_type,
    guest_count: totalGuests.value,
    table_count: form.value.table_count,
    spare_tables: form.value.spare_tables,
    guest_per_table: form.value.guest_per_table,
    deposit: form.value.deposit ? Number(form.value.deposit) : 0,
    booking_status: form.value.booking_status,
    remark: form.value.remark,
    table_ids: selectedTables.value.flatMap(t => { const id = t.table_id ?? t.id; return id != null ? [id] : []; }),
    table_names: selectedTables.value.flatMap(t => { const n = t.table_number || t.table_name; return n ? [n] : []; }),
    dishes: dishOrderItems.value
  }

  try {
    const res = await fetch('/api/bookings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify(body)
    })
    const data = await res.json()
    if (data.code === 200) {
      ElMessage.success('保存成功：' + data.data?.bookingId)
      visible.value = false
      // 清除 local dish orders
      localStorage.removeItem('dishOrders:' + (form.value.booking_date || ''))
      emit('saved', data.data)
    } else {
      ElMessage.error(data.message || '保存失败')
    }
  } catch (e) {
    ElMessage.error('网络错误：' + e.message)
  } finally {
    loading.value = false
  }
}

function doCancel() {
  visible.value = false
}
</script>

<style scoped>
.booking-dialog :deep(.el-tabs__item) { padding: 0 10px !important; font-size: 12px !important; }
.booking-dialog :deep(.el-tabs__header) { margin-bottom: 12px; }
.booking-form :deep(.el-form-item) { margin-bottom: 14px; }
.dialog-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 16px; padding-top: 12px; border-top: 1px solid #e5e7eb; }
.table-tag { display: inline-block; background: #ecf5ff; color: #409eff; padding: 2px 8px; border-radius: 4px; margin: 2px 4px; font-size: 13px; }
.table-tag .close-icon { cursor: pointer; margin-left: 4px; color: #909399; }
.table-tag .close-icon:hover { color: #f56c6c; }
.menu-status-tag { margin-left: 8px; }
.history-list { max-height: 300px; overflow-y: auto; }
.history-item { padding: 8px; margin: 4px 0; background: #f5f7fa; border-radius: 6px; }
.history-header { display: flex; justify-content: space-between; font-size: 13px; color: #606266; }
.history-body { display: flex; gap: 16px; font-size: 14px; margin-top: 4px; }
.history-status.confirmed { color: #67c23a; }
.history-status.completed { color: #909399; }
.history-status.cancelled { color: #f56c6c; }
.dish-list { max-height: 300px; overflow-y: auto; }
.dish-item { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #ebeef5; }
.dish-total { text-align: right; font-weight: bold; margin-top: 8px; }
</style>
