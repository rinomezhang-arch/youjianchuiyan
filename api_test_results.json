  "table_structure": "+-----------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+\n| Table           | Create Table                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |\n+-----------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+\n| customer_master | CREATE TABLE `customer_master` (\n  `customer_id` int NOT NULL AUTO_INCREMENT,\n  `store_id` bigint NOT NULL DEFAULT '1',\n  `customer_name` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `customer_phone` varchar(20) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `customer_preference` text COLLATE utf8mb4_unicode_ci,\n  `total_amount` decimal(12,2) DEFAULT '0.00',\n  `member_level` varchar(10) COLLATE utf8mb4_unicode_ci DEFAULT 'v1',\n  `booking_count` int DEFAULT '0',\n  `last_booking_date` date DEFAULT NULL,\n  `remark` text COLLATE utf8mb4_unicode_ci,\n  `is_active` tinyint DEFAULT '1',\n  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (`customer_id`),\n  UNIQUE KEY `uk_store_name_phone` (`store_id`,`customer_name`,`customer_phone`),\n  KEY `idx_store` (`store_id`),\n  KEY `idx_phone` (`customer_phone`),\n  KEY `idx_name` (`customer_name`),\n  KEY `idx_level` (`member_level`),\n  KEY `idx_store_customer` (`store_id`,`customer_phone`)\n) ENGINE=InnoDB AUTO_INCREMENT=222 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci |\n+-----------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+\n",
  "table_describe": "+---------------------+---------------+------+-----+-------------------+-----------------------------------------------+\n| Field               | Type          | Null | Key | Default           | Extra                                         |\n+---------------------+---------------+------+-----+-------------------+-----------------------------------------------+\n| customer_id         | int           | NO   | PRI | NULL              | auto_increment                                |\n| store_id            | bigint        | NO   | MUL | 1                 |                                               |\n| customer_name       | varchar(50)   | NO   | MUL | NULL              |                                               |\n| customer_phone      | varchar(20)   | NO   | MUL | NULL              |                                               |\n| customer_preference | text          | YES  |     | NULL              |                                               |\n| total_amount        | decimal(12,2) | YES  |     | 0.00              |                                               |\n| member_level        | varchar(10)   | YES  | MUL | v1                |                                               |\n| booking_count       | int           | YES  |     | 0                 |                                               |\n| last_booking_date   | date          | YES  |     | NULL              |                                               |\n| remark              | text          | YES  |     | NULL              |                                               |\n| is_active           | tinyint       | YES  |     | 1                 |                                               |\n| created_at          | timestamp     | YES  |     | CURRENT_TIMESTAMP | DEFAULT_GENERATED                             |\n| updated_at          | timestamp     | YES  |     | CURRENT_TIMESTAMP | DEFAULT_GENERATED on update CURRENT_TIMESTAMP |\n+---------------------+---------------+------+-----+-------------------+-----------------------------------------------+\n",
